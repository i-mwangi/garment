# Native NEAR wallet configuration. The two networks select separate services.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.fastnear.com
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=
NEXT_PUBLIC_WEB3AUTH_NETWORK=sapphire_devnet
SETTLBOX_NEAR_TREASURY_CONFIG=.data/near-treasury.json
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SERVER_URL=
SETTLBOX_APP_ORIGIN=
SETTLBOX_SESSION_DATABASE=.data/sessions.sqlite
SETTLBOX_BUSINESS_DATABASE=.data/business.sqlite
SETTLBOX_UPLOAD_DIRECTORY=.data/uploads
SETTLBOX_OPERATOR_TOKEN=
SETTLBOX_LOGIN_EMAIL=
SETTLBOX_LOGIN_PASSWORD_HASH=
# Finance chat: azure, near_ai, or empty for the deterministic fallback.
SETTLBOX_AI_PROVIDER=azure
# Resource root URL, e.g. https://your-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# Azure deployment name, rather than a generic model identifier.
AZURE_OPENAI_DEPLOYMENT=settlbox-finance-chat
# Server-only credential. Configure locally; never use NEXT_PUBLIC_ for this key.
AZURE_OPENAI_API_KEY=
# Server-only NEAR AI Cloud key and exact model ID. Select near_ai only after
# the owner sets a nonzero inference budget and releases the business stop switch.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=

# Server-only partner API key for the Base USDC 1Click corridor.
SETTLBOX_1CLICK_API_KEY=

# Server-only secret for the bounded finance runner. Generate at least 32 random characters.
SETTLBOX_FINANCE_WORKER_TOKEN=

# Optional remote MCP bearer token. Settings stores this variable name only.
SETTLBOX_MCP_ACCOUNTING_TOKEN=
# Inbound MCP credentials are created/revoked in Settings and stored hashed in the
# business database. Client bearer tokens belong in the external client's private
# environment; do not reuse SETTLBOX_OPERATOR_TOKEN or provider credentials.

# Per-business Kora sandbox secret. Live keys are rejected.
SETTLBOX_KORA_COMPANY_TEST_KEY=
SETTLBOX_KORA_COMPANY_TEST_PUBLIC_KEY=
# Server-only status reconciliation credential; cannot submit payouts.
SETTLBOX_PAYOUT_STATUS_TOKEN=

# Trusted public HTTPS origin for inbound MCP OAuth discovery and callbacks.
SETTLBOX_OAUTH_ISSUER=
# Explicit additional browser origins (comma separated), e.g. the public tunnel.
SETTLBOX_ADDITIONAL_APP_ORIGINS=

# Server-only integration credential encryption: 32 random bytes as 64 hex characters.
SETTLBOX_INTEGRATION_ENCRYPTION_KEY=
SETTLBOX_GOOGLE_CLIENT_ID=
SETTLBOX_GOOGLE_CLIENT_SECRET=
SETTLBOX_GOOGLE_REDIRECT_URI=http://127.0.0.1:3002/api/integrations/google-sheets/callback

# Native Slack channel webhook and restricted Stripe read key (server-only).
SETTLBOX_SLACK_COMPANY_WEBHOOK_URL=
SETTLBOX_STRIPE_COMPANY_READ_KEY=


# Native NEAR contract bindings and restricted server executor.
SETTLBOX_NEAR_CONTRACT_CONFIG=.data/near-contracts.json
SETTLBOX_NEAR_EXECUTOR_KEY_FILE=.data/near-executor-key.json
SETTLBOX_NEAR_EXECUTOR_DATABASE=.data/near-executor.sqlite

# Separate local deployment authority files; never reuse these as server executor credentials.
SETTLBOX_NEAR_VAULT_DEPLOYER_KEY_FILE=
SETTLBOX_NEAR_GIFT_DEPLOYER_KEY_FILE=
SETTLBOX_NEAR_VAULT_POLICY=.data/near-vault-policy.json
SETTLBOX_NEAR_DEPLOYMENT_DATABASE=.data/near-deployment.sqlite
# Optional native read fallback; its chain is verified before use.
NEXT_PUBLIC_NEAR_BACKUP_RPC_URL=https://rpc.testnet.near.org
SETTLBOX_NEAR_EARN_CONFIG=.data/near-earn.json

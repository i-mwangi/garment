{
  "name": "settlbox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "agent:worker": "node --env-file-if-exists=.env.local scripts/finance-agent-worker.mjs",
    "dev": "next dev --turbopack",
    "build": "node scripts/build-production.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "lint": "next lint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:near": "tsc --project tsconfig.near.json --noEmit",
    "test:near": "node --experimental-strip-types --test tests/near-foundations.test.mjs tests/near-wallet-proof.test.mjs tests/near-sdk-signing.test.mjs tests/team-members.test.mjs tests/near-link-settlement.test.mjs tests/payment-links.test.mjs tests/group-collections.test.mjs tests/business-records.test.mjs tests/workspace-records.test.mjs tests/payroll-contracts.test.mjs tests/reimbursements.test.mjs tests/payment-schedules.test.mjs tests/near-invoice-total.test.mjs tests/seeded-workspace.test.mjs tests/near-contracts.test.mjs tests/near-deployment.test.mjs tests/near-gift-settlement.test.mjs tests/gift-records.test.mjs tests/near-vault-admin.test.mjs tests/near-executor-journal.test.mjs tests/vault-payment-journal.test.mjs tests/agent-planner.test.mjs tests/near-vault-settlement.test.mjs tests/near-ownership.test.mjs tests/finance-worker.test.mjs tests/near-rhea.test.mjs tests/near-read-recovery.test.mjs tests/near-ui-assets.test.mjs tests/near-treasury-view.test.mjs tests/near-runtime-boundaries.test.mjs",
    "verify:api": "node --env-file-if-exists=.env.local scripts/verify-treasury-api.mjs",
    "verify:business": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/verify-business-records.mjs",
    "verify:workspace": "node --env-file-if-exists=.env.local scripts/verify-workspace.mjs",
    "schedules:prepare": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/prepare-scheduled-payments.mjs",
    "contracts:compile": "node scripts/compile-gift-escrow.mjs",
    "contracts:prepare": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/prepare-embedded-contracts.mjs",
    "contracts:funding-check": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/check-embedded-funding.mjs",
    "contracts:deploy": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/deploy-gift-escrow.mjs",
    "verify:gifts": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/verify-gifts.mjs",
    "seed:workspaces": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed-workspaces.mjs",
    "seed:reimbursements": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed-reimbursements.mjs",
    "seed:provider-history": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed-provider-history.mjs",
    "seed:demo": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed-workspaces.mjs && node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed-reimbursements.mjs && node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed-provider-history.mjs",
    "verify:reimbursements": "node --env-file-if-exists=.env.local scripts/verify-reimbursements.mjs",
    "vault:compile": "node scripts/compile-treasury-vault.mjs",
    "vault:prepare": "node --experimental-strip-types scripts/prepare-treasury-vault.mjs",
    "vault:deploy": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/deploy-treasury-vault.mjs",
    "verify:near": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/verify-near-testnet.mjs"
  },
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "0.1.26",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/client": "^2.3.1",
    "@noble/curves": "2.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "@reactour/tour": "^3.8.0",
    "@tanstack/react-query": "^5.90.12",
    "@web3auth/modal": "11.4.3",
    "ajv": "^8.20.0",
    "blo": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iconoir-react": "^7.11.0",
    "immer": "^10.2.0",
    "ipaddr.js": "^2.5.0",
    "lodash": "^4.17.21",
    "motion": "^12.40.0",
    "near-api-js": "7.4.0",
    "next": "15.5.27",
    "pdf-lib": "^1.17.1",
    "qr-code-styling": "^1.9.2",
    "react": "^19.2.1",
    "react-day-picker": "^9.8.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.60.0",
    "react-hot-toast": "^2.5.2",
    "react-is": "^19.2.1",
    "react-loading-skeleton": "^3.5.0",
    "react-tooltip": "^5.29.1",
    "recharts": "^3.1.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.21.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/lodash": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-is": "^19",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.29",
    "@grpc/grpc-js": "1.14.6",
    "undici": "6.29.0",
    "uuid": "11.1.1"
  }
}
